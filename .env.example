# Frontend build-time API origin. Leave unset for same-origin production.
# For local development, the frontend automatically uses the current host on
# port 8010, including a phone connected through the same private LAN.
VITE_API_BASE_URL=

# Comma-separated production browser origins. Never use "*" in production.
TRUSTSCOPE_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Enables development access from RFC1918 private-LAN browser origins.
TRUSTSCOPE_ALLOW_PRIVATE_LAN=true

# Add a newly rotated provider credential only to a local .env or secret
# manager. Never put a real key in this example file or in frontend variables.
OPENROUTER_API_KEY=

# Optional server-side review-only AI advisory configuration. The default
# model is pinned in code and can be changed without exposing the credential.
TRUSTSCOPE_OPENROUTER_ENABLED=true
TRUSTSCOPE_OPENROUTER_MODEL=openai/gpt-oss-20b
TRUSTSCOPE_OPENROUTER_TIMEOUT_SECONDS=15
