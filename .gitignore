# Python virtual environments
.venv/
backend/.venv/
venv/
env/

# Python cache and build files
__pycache__/
*.py[cod]
*.pyd
*.so
.pytest_cache/
.mypy_cache/
.ruff_cache/
build/
dist/
*.egg-info/

# Frontend dependencies and generated files
frontend/node_modules/
frontend/dist/
frontend/.vite/

# Environment files and secrets
.env
.env.*
!.env.example
*.pem
*.key
secrets/
credentials/

# VS Code local settings
.vscode/
*.code-workspace

# Operating-system files
.DS_Store
Thumbs.db
desktop.ini

# Logs and temporary files
*.log
*.tmp
*.temp
temp/
tmp/
.trustscope-local/
.pnpm-store/

# Uploaded user media
sample_uploads/documents/*
sample_uploads/images/*
sample_uploads/videos/*

# Keep empty sample-upload folders
!sample_uploads/documents/.gitkeep
!sample_uploads/images/.gitkeep
!sample_uploads/videos/.gitkeep

# Downloaded AI models and caches
models/
model_cache/
.cache/
huggingface/

# Generated video frames or audio
extracted_frames/
extracted_audio/
backend/storage/

# Local review database
# Contains submitted content and must not be uploaded to GitHub
backend/data/
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3
# Downloaded public benchmark datasets
datasets/public/

# Generated evaluation outputs and mismatches
reports/
backend/evaluation_reports/
# Private independent holdouts — never publish or use for tuning
datasets/holdout/
backend/scripts/*holdout*.py
# Official evidence data requires separate legal review
datasets/official_evidence/
# Local migration backups
*.backup-*
*.before-*
*.phase1-backup
*.before_*
backend/app/services/india_evidence_service.py
backend/app/services/misinformation_service.py
backend/scripts/diagnose_fever_evidence_pipeline.py
backend/scripts/download_fever_dataset.py
backend/scripts/evaluate_fever_misinformation.py
backend/scripts/fix_*.py
backend/scripts/install_official_evidence_cache.py
backend/scripts/integrate_india_evidence_misinformation.py
backend/scripts/refine_india_evidence_topics.py
backend/scripts/upgrade_*.py
backend/scripts/evaluate_india_world_fact_check_challenge.py
backend/scripts/evaluate_stable_knowledge_benchmark.py

# TrustScopeAI Terrorism RC4 publication boundaries
# Independent challenges remain private and must never be used for tuning.
datasets/evaluation/
backend/scripts/evaluate_*_independent.py

# Illegal Activities V1 RC1 publication boundary
# The synthetic aggregate evaluator and frozen candidate are publishable.
# Raw challenge text, individual predictions, and general evaluation outputs
# remain excluded by the rules above.
!backend/scripts/evaluate_illegal_activities_v1_rc1_independent.py
!backend/storage/
backend/storage/*
!backend/storage/candidates/
backend/storage/candidates/*
!backend/storage/candidates/illegal-activities-v1-rc1/
!backend/storage/candidates/illegal-activities-v1-rc1/**

# Illegal Activities V2 RC2 publication boundary
# Publish only the aggregate synthetic evaluator and frozen candidate evidence.
!backend/scripts/evaluate_illegal_activities_v2_rc2_independent.py
!backend/storage/candidates/illegal-activities-v2-rc2/
!backend/storage/candidates/illegal-activities-v2-rc2/**

# Wikidata structured community candidates are CC0 and review-routing only.
# All other downloaded public benchmark datasets remain ignored.
!datasets/public/
datasets/public/*
!datasets/public/wikidata_terrorism_candidates_v1/
!datasets/public/wikidata_terrorism_candidates_v1/**
